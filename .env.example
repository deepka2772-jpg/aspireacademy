# Aspire Academy Online - Environment Variables Configuration
# Copy this file to .env or configure in your deployment platform

# AI Studio runtime variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"

# Razorpay Indian Payment Gateway Configuration
# Obtain from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"

# Cloudflare R2 Object Storage Configuration (S3 Compatible)
# Obtain from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID="YOUR_CLOUDFLARE_ACCOUNT_ID"
R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="aspire-academy-media"
R2_PUBLIC_DOMAIN=""
